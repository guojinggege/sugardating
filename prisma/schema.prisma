// Lumina — Prisma schema (PostgreSQL, 用于 Neon + Vercel)
// 表结构与本地 SQLite 阶段保持一致;只把 provider 切到 postgresql、
// 之前用 String 存 JSON 的两个字段(benefits)改成原生 Json(Postgres jsonb)
//
// "枚举型"字段(role / type / visibility / tier / period / status / etc.)
// 仍然用 String — 不用 Prisma enum,加一个值不需要 schema migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon 通过 PgBouncer(pooler)接 url,但 migration/introspection 要直连
  // → directUrl 走非 pooler 端点
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  password           String       // PBKDF2 hash format: "pbkdf2$iters$saltHex$hashHex"
  role               String       @default("creator") // user | creator | admin
  createdAt          DateTime     @default(now())
  passwordUpdatedAt  DateTime?
  creator            Creator?
  memberships        Membership[]
  follows            Follow[]
}

// 关注关系 · 唯一权威数据源
// creatorSlug 是稳定标识 · Prisma Creator + mock sugarboy/massage 都用 slug 定位
// creatorType 用于区分类型 (只做 informational · 不影响关系键)
model Follow {
  id           String   @id @default(cuid())
  userId       String
  creatorSlug  String
  creatorType  String   @default("sugargirl") // sugargirl | sugarboy | massage
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorSlug])
  @@index([userId, createdAt])
  @@index([creatorSlug])
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  label    String
  creators Creator[]
}

model Region {
  id       Int       @id @default(autoincrement())
  label    String    @unique
  creators Creator[]
}

model Creator {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  specialty  String
  price      String   // 展示用,如 "S$6"
  tier       String   // basic | pro | elite
  subs       Int      @default(0)
  followers  Int      @default(0)
  worksCount Int      @default(0)
  bio        String?
  userId     String   @unique
  categoryId Int
  regionId   Int
  createdAt  DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])
  region   Region     @relation(fields: [regionId], references: [id])
  works    Work[]
  tiers    TierPlan[]
  tips     Tip[]
  comments Comment[]
}

model Work {
  id         String   @id @default(cuid())
  title      String
  type       String   @default("image") // image | video
  visibility String   @default("public") // public | subscriber
  creatorId  String
  createdAt  DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])
}

model TierPlan {
  id        Int    @id @default(autoincrement())
  name      String // basic | pro | elite
  label     String // 入门 / 进阶 / Elite
  price     String // "S$6"
  benefits  Json   // 字符串数组,原生 jsonb 存
  creatorId String

  creator Creator @relation(fields: [creatorId], references: [id])
}

model Tip {
  id        String   @id @default(cuid())
  amount    Int      // 整数(单位 S$),不接真实支付,只记录
  message   String?  // 可选留言
  creatorId String
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([creatorId, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  authorName String
  content    String
  creatorId  String
  createdAt  DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([creatorId, createdAt])
}

// 平台会员套餐 — 3 等级 × 4 周期 = 12 行
model MembershipPlan {
  id        String   @id @default(cuid())
  tier      String   // basic | premium | elite
  period    String   // week | month | quarter | year
  price     Int      // 分(SGD cents)
  currency  String   @default("SGD")
  benefits  Json     // 字符串数组,原生 jsonb 存
  bestValue Boolean  @default(false)
  sortKey   Int      @default(0)
  createdAt DateTime @default(now())

  memberships Membership[]

  @@unique([tier, period])
}

// Sugargirl 入驻意向 · /apply 页面提交 · 同时是后台 Applications 审核数据源
// 提交时公开无需登录 · 审核字段仅 admin 可写
model CreatorInterest {
  id           String   @id @default(cuid())
  // 用户提交 · 原始字段
  nickname     String
  city         String
  status       String   // student | employed | freelancer
  telephone    String?
  email        String?
  mobile       String?
  locale       String?  // zh | en
  source       String?  // hero | sticky | inline | final
  ipHash       String?  // salt-based SHA-256 前 12 位
  userAgent    String?  // 截断 200
  createdAt    DateTime @default(now())
  // 后台审核 · admin 可写
  reviewStatus String   @default("submitted") // submitted | reviewing | needs_changes | approved | rejected
  reviewNotes  String?
  reviewedAt   DateTime?
  reviewedBy   String?  // admin userId

  @@index([createdAt])
  @@index([reviewStatus, createdAt])
}

// 用户开通的会员 — userId 暂时可空,待 auth 接入后回填
model Membership {
  id        String   @id @default(cuid())
  userId    String?
  planId    String
  startsAt  DateTime @default(now())
  endsAt    DateTime
  status    String   @default("active") // active | expired | cancelled
  createdAt DateTime @default(now())

  user User?           @relation(fields: [userId], references: [id])
  plan MembershipPlan  @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
}
