// Lumina — Prisma schema (PostgreSQL, 用于 Neon + Vercel)
// 表结构与本地 SQLite 阶段保持一致;只把 provider 切到 postgresql、
// 之前用 String 存 JSON 的两个字段(benefits)改成原生 Json(Postgres jsonb)
//
// "枚举型"字段(role / type / visibility / tier / period / status / etc.)
// 仍然用 String — 不用 Prisma enum,加一个值不需要 schema migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon 通过 PgBouncer(pooler)接 url,但 migration/introspection 要直连
  // → directUrl 走非 pooler 端点
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  password           String       // PBKDF2 hash format: "pbkdf2$iters$saltHex$hashHex"
  role               String       @default("creator") // user | creator | admin
  createdAt          DateTime     @default(now())
  passwordUpdatedAt  DateTime?
  creator            Creator?
  memberships        Membership[]
  follows            Follow[]
}

// 关注关系 · 唯一权威数据源
// creatorSlug 是稳定标识 · Prisma Creator + mock sugarboy/massage 都用 slug 定位
// creatorType 用于区分类型 (只做 informational · 不影响关系键)
model Follow {
  id           String   @id @default(cuid())
  userId       String
  creatorSlug  String
  creatorType  String   @default("sugargirl") // sugargirl | sugarboy | massage
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorSlug])
  @@index([userId, createdAt])
  @@index([creatorSlug])
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  label    String
  creators Creator[]
}

model Region {
  id       Int       @id @default(autoincrement())
  label    String    @unique
  creators Creator[]
}

model Creator {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  specialty  String
  price      String   // 展示用,如 "S$6"
  tier       String   // basic | pro | elite
  subs       Int      @default(0)
  followers  Int      @default(0)
  worksCount Int      @default(0)
  bio        String?
  userId     String   @unique
  categoryId Int
  regionId   Int
  createdAt  DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])
  region   Region     @relation(fields: [regionId], references: [id])
  works    Work[]
  tiers    TierPlan[]
  tips     Tip[]
  comments Comment[]
}

model Work {
  id         String   @id @default(cuid())
  title      String
  type       String   @default("image") // image | video
  visibility String   @default("public") // public | subscriber
  creatorId  String
  createdAt  DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])
}

model TierPlan {
  id        Int    @id @default(autoincrement())
  name      String // basic | pro | elite
  label     String // 入门 / 进阶 / Elite
  price     String // "S$6"
  benefits  Json   // 字符串数组,原生 jsonb 存
  creatorId String

  creator Creator @relation(fields: [creatorId], references: [id])
}

model Tip {
  id        String   @id @default(cuid())
  amount    Int      // 整数(单位 S$),不接真实支付,只记录
  message   String?  // 可选留言
  creatorId String
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([creatorId, createdAt])
}

model Comment {
  id         String   @id @default(cuid())
  authorName String
  content    String
  creatorId  String
  createdAt  DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id])

  @@index([creatorId, createdAt])
}

// 平台会员套餐 — 3 等级 × 4 周期 = 12 行
model MembershipPlan {
  id        String   @id @default(cuid())
  tier      String   // basic | premium | elite
  period    String   // week | month | quarter | year
  price     Int      // 分(SGD cents)
  currency  String   @default("SGD")
  benefits  Json     // 字符串数组,原生 jsonb 存
  bestValue Boolean  @default(false)
  sortKey   Int      @default(0)
  createdAt DateTime @default(now())

  memberships Membership[]

  @@unique([tier, period])
}

// Sugargirl 入驻意向 · /apply 页面提交 · 后台只读展示
// 提交时公开无需登录 · 旧联系方式字段保留仅用于历史记录
model CreatorInterest {
  id             String   @id @default(cuid())
  nickname       String
  city           String
  status         String   // student | employed | freelancer

  // 新联系方式 · 表单顺序:WhatsApp / Ins / X / 其他 · 四选一必填
  whatsapp       String?
  instagram      String?
  xHandle        String?  @map("x_handle")
  otherContact   String?  @map("other_contact")

  // 旧联系方式 · 保留兼容历史 · 新提交不再写入
  telephone      String?
  email          String?
  mobile         String?

  // 合规确认
  ageConfirmed   Boolean  @default(false)
  contactConsent Boolean  @default(false)

  // 来源与归因
  locale         String?  // zh | en
  source         String?  // inline_form | header_apply | hero_apply | floating_primary | ...
  pagePath       String?  @map("page_path")
  referrer       String?
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  utmContent     String?  @map("utm_content")

  // 安全审计
  ipHash         String?  // salt-based SHA-256 前 12 位
  userAgent      String?  // 截断 200
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  // 审核字段 (已下线 UI) · 保留列避免破坏性 migration
  reviewStatus   String   @default("submitted")
  reviewNotes    String?
  reviewedAt     DateTime?
  reviewedBy     String?

  @@index([createdAt])
  @@index([reviewStatus, createdAt])
}

// 用户开通的会员 — userId 暂时可空,待 auth 接入后回填
model Membership {
  id        String   @id @default(cuid())
  userId    String?
  planId    String
  startsAt  DateTime @default(now())
  endsAt    DateTime
  status    String   @default("active") // active | expired | cancelled
  createdAt DateTime @default(now())

  user User?           @relation(fields: [userId], references: [id])
  plan MembershipPlan  @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([planId])
}
